agent-disclosure:
    lake build Examples.Health.Pseudonymization.CrossStep Examples.Health.Pseudonymization.AgentDisclosureExport Examples.Manifests
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 --run Examples/Manifests.lean pseudonymization-agent-disclosure > .lake/build/pseudonymization-agent-disclosure-manifest.json
    jq -e '(.cases | length) == 14 and ([.cases[].name] | unique | length) == 14' .lake/build/pseudonymization-agent-disclosure-manifest.json > /dev/null
    cargo run --locked --quiet --features cedar-runtime --manifest-path rust/Cargo.toml -- replay-validated-receipts < .lake/build/pseudonymization-agent-disclosure-manifest.json > .lake/build/pseudonymization-agent-disclosure-receipts.json
    jq -e 'length == 14 and all(.[]; .replay.error_policy_ids == [] and (.schema_sha256 | test("^[0-9a-f]{64}$"))) and ([.[] | select(.replay.decision == "deny") | .replay.case_name] | sort) == ["source-budget-exhausted", "source-cohort-second-after-first", "source-delegation-missing", "source-delegation-revoked", "source-dropped-label", "source-governed-external", "source-incident", "source-missing-owner", "source-substituted-output"]' .lake/build/pseudonymization-agent-disclosure-receipts.json > /dev/null
    cargo run --locked --quiet --features cedar-runtime --manifest-path rust/Cargo.toml --example agent_disclosure_host -- .lake/build/pseudonymization-agent-disclosure-manifest.json > .lake/build/agent-disclosure-host-receipt.json
    jq -e '.committed.epoch == 1 and .committed.remainingBudget == 1 and .committed.remainingCandidates == 4 and .auditEntries == 1 and .secondAloneAllowed and .cumulativeSecondDenied and .concurrentSingleCommit and .revokedDenied and .auditFailureDenied and .wrongIssuerDenied' .lake/build/agent-disclosure-host-receipt.json > /dev/null

pseudonymization-google-contract:
    lake build Examples.Manifests
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 --run Examples/Manifests.lean pseudonymization-tabular > .lake/build/pseudonymization-tabular.json
    cmp .lake/build/pseudonymization-tabular.json Examples/Health/Pseudonymization/Fixtures/tabular-aes-siv.json
    cargo run --locked --quiet --features google-sdp --manifest-path rust/Cargo.toml --example pseudonymization_google_contract -- Examples/Health/Pseudonymization/Fixtures/tabular-aes-siv.json Examples/Health/Pseudonymization/Fixtures/google-deidentify-response.json Examples/Health/Pseudonymization/Fixtures/google-reidentify-response.json > .lake/build/pseudonymization-google-contract-receipt.json
    jq -e -f Tests/Conformance/pseudonymization-google-contract-receipt.jq .lake/build/pseudonymization-google-contract-receipt.json > /dev/null

