australian-emr: package-metadata
    lake build Examples.Health.Interoperability.Admission Examples.Health.Interoperability.ValidatedExport Examples.Manifests
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 --run Examples/Manifests.lean australian-emr-upload > .lake/build/australian-emr-upload-manifest.json
    jq -e '(.cases | length) == 17 and ([.cases[].name] | unique | length) == 17' .lake/build/australian-emr-upload-manifest.json > /dev/null
    cargo run --locked --quiet --features cedar-runtime --manifest-path rust/Cargo.toml -- replay-validated-receipts < .lake/build/australian-emr-upload-manifest.json > .lake/build/australian-emr-upload-receipts.json
    jq -e 'length == 17 and all(.[]; .replay.error_policy_ids == [] and (.schema_sha256 | test("^[0-9a-f]{64}$"))) and ([.[] | select(.replay.decision == "deny") | .replay.case_name] | sort) == ["admission-au-other-publication", "admission-au-other-resource", "admission-au-substituted-selection", "agent-cannot-upload", "document-unattested", "ihi-unverified", "incident-freezes-upload", "other-patient", "patient-declined", "recovered-still-honors-instruction", "source-swapped", "wrong-document-class", "wrong-purpose"]' .lake/build/australian-emr-upload-receipts.json > /dev/null

