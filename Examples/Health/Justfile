set working-directory := '../..'

clinical-break-glass:
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 Examples/Health/ClinicalBreakGlass.lean

pseudonymization-google-contract:
    lake build Examples.Manifests
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 --run Examples/Manifests.lean pseudonymization-tabular > .lake/build/pseudonymization-tabular.json
    cmp .lake/build/pseudonymization-tabular.json Examples/Health/Pseudonymization/Fixtures/tabular-aes-siv.json
    cargo run --locked --quiet --features google-sdp --manifest-path rust/Cargo.toml --example pseudonymization_google_contract -- Examples/Health/Pseudonymization/Fixtures/tabular-aes-siv.json Examples/Health/Pseudonymization/Fixtures/google-deidentify-response.json Examples/Health/Pseudonymization/Fixtures/google-reidentify-response.json > .lake/build/pseudonymization-google-contract-receipt.json
    jq -e '.kind == "offline-google-sdp-rest-contract" and .providerCalled == false and .contextSwapRejected == true and .keyLineageMismatchRejected == true and .malformedTokenRejected == true and .syntheticRoundTripShapeChecked == true and ([.deidentifyRequestSha256, .deidentifyResponseSha256, .reidentifyRequestSha256, .reidentifyResponseSha256] | all(.[]; test("^[0-9a-f]{64}$")))' .lake/build/pseudonymization-google-contract-receipt.json > /dev/null

pseudonymization-google-admission:
    lake build Examples.Manifests
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 --run Examples/Manifests.lean pseudonymization-validated > .lake/build/pseudonymization-validated-manifest.json
    cargo run --locked --quiet --features google-sdp-host --manifest-path rust/Cargo.toml --example pseudonymization_google_admission -- .lake/build/pseudonymization-validated-manifest.json Examples/Health/Pseudonymization/Fixtures/tabular-aes-siv.json Examples/Health/Pseudonymization/Fixtures/google-deidentify-response.json Examples/Health/Pseudonymization/Fixtures/google-reidentify-response.json > .lake/build/pseudonymization-google-admission-receipt.json
    jq -e '.kind == "offline-google-sdp-admission" and .providerCalled == false and .staleRaceRejected == true and .deniedAgentRejected == true and .wrongScopeRejected == true and .revokedRejected == true and .auditFailureRejected == true and .responseSwapRejected == true and .endpointSwapRejected == true and .policyChangeRejected == true and .auditEntries == 2 and ([.audits[] | .schemaSha256, .policiesSha256, .cedarRequestSha256, .googleRequestSha256, .googleResponseSha256] | all(.[]; test("^[0-9a-f]{64}$")))' .lake/build/pseudonymization-google-admission-receipt.json > /dev/null

pseudonymization: pseudonymization-google-contract pseudonymization-google-admission
    just build-examples
    timeout --signal=TERM --kill-after=3s 20s lake env lean -M 2048 -T 10000000 Examples/Health/Pseudonymization/Lifecycle.lean
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 --run Examples/Manifests.lean pseudonymization-tabular > .lake/build/pseudonymization-tabular.json
    cmp .lake/build/pseudonymization-tabular.json Examples/Health/Pseudonymization/Fixtures/tabular-aes-siv.json
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 --run Examples/Manifests.lean pseudonymization-validated > .lake/build/pseudonymization-validated-manifest.json
    jq -e '(.cases | length) == 41 and (.schema[""].actions | keys) == ["join", "reidentify", "release-result", "tokenize"] and ([.cases[] | select(.revision == "Recovered")][0].policies == [.cases[] | select(.revision == "HospitalSiv")][0].policies)' .lake/build/pseudonymization-validated-manifest.json > /dev/null
    cargo run --locked --quiet --features cedar-runtime --manifest-path rust/Cargo.toml -- replay-validated-receipts < .lake/build/pseudonymization-validated-manifest.json > .lake/build/pseudonymization-validated-receipts.json
    jq -e 'length == 41 and all(.[]; .replay.error_policy_ids == [] and (.schema_sha256 | test("^[0-9a-f]{64}$"))) and ([.[] | select(.replay.decision == "deny") | .replay.case_name] | sort) == ["agent-reidentify", "agent-tokenization-oracle", "audit-unavailable", "cross-study-join", "gcm-no-deterministic-join", "gcm-reused-iv", "hmac-no-reidentification", "incident-agent-join", "incompatible-token-mode", "no-reidentify-approval", "operator-reidentify", "other-tenant-join", "owner-rejected", "reidentify-other-dataset", "reidentify-without-key", "result-release-budget-exhausted", "result-release-other-dataset", "result-release-owner-revoked", "result-release-without-approval", "result-release-wrong-actor", "revised-transform", "rotated-token-key", "tokenize-other-dataset", "tokenize-without-key", "wrong-key-domain", "wrong-reidentification-key-version"]' .lake/build/pseudonymization-validated-receipts.json > /dev/null
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 --run Examples/Manifests.lean pseudonymization-deployable > .lake/build/pseudonymization-deployable.json
    jq -e '([.[].root] | sort) == ["AgentIncident", "HospitalSiv", "OneWayHmac", "RandomizedGcm", "Recovered", "ResultRelease"] and all(.[]; (.policies.staticPolicies | has("legacy-reidentify") | not))' .lake/build/pseudonymization-deployable.json > /dev/null
    cargo test --locked --features cedar-runtime,google-sdp --manifest-path rust/Cargo.toml --test pseudonymization_crypto
    cargo run --locked --quiet --features cedar-runtime --manifest-path rust/Cargo.toml --example pseudonymization_local -- .lake/build/pseudonymization-validated-manifest.json Examples/Health/Pseudonymization/Fixtures/tabular-aes-siv.json > .lake/build/pseudonymization-local-receipt.json
    jq -e '.kind == "synthetic-local-aes-siv" and .caseName == "hospital-tokenize" and .decision == "allow" and .reidentifyDecision == "allow" and .roundTripMatches == true and .dataset == "hospital-patients" and .context == "hospital-a" and .tokenBytes > 0 and ([.schemaSha256, .policiesSha256, .entitiesSha256, .requestSha256, .reidentifyRequestSha256, .inputHmacSha256, .tokenSha256] | all(.[]; test("^[0-9a-f]{64}$")))' .lake/build/pseudonymization-local-receipt.json > /dev/null
    jq '.context = "study-two"' Examples/Health/Pseudonymization/Fixtures/tabular-aes-siv.json > .lake/build/pseudonymization-wrong-context.json
    ! cargo run --locked --quiet --features cedar-runtime --manifest-path rust/Cargo.toml --example pseudonymization_local -- .lake/build/pseudonymization-validated-manifest.json .lake/build/pseudonymization-wrong-context.json > .lake/build/pseudonymization-rejected-output.json
    jq '.tokenKeyVersion = "dek-v2"' Examples/Health/Pseudonymization/Fixtures/tabular-aes-siv.json > .lake/build/pseudonymization-wrong-key.json
    ! cargo run --locked --quiet --features cedar-runtime --manifest-path rust/Cargo.toml --example pseudonymization_local -- .lake/build/pseudonymization-validated-manifest.json .lake/build/pseudonymization-wrong-key.json > .lake/build/pseudonymization-rejected-output.json
    cargo run --locked --quiet --features cedar-runtime --manifest-path rust/Cargo.toml -- identified-sources hospital-tokenize < .lake/build/pseudonymization-validated-manifest.json > .lake/build/hospital-siv-sources.json
    jq -e '(keys | length) == 10 and has("join") and has("tokenize") and has("agent-cannot-reidentify")' .lake/build/hospital-siv-sources.json > /dev/null
    jq '[.cases[] | select(.revision == "HospitalSiv")][0].policies' .lake/build/pseudonymization-validated-manifest.json | cargo run --locked --quiet --features cedar-runtime --manifest-path rust/Cargo.toml -- render > .lake/build/hospital-siv.cedar
    cmp .lake/build/hospital-siv.cedar Examples/Health/Pseudonymization/Policies/hospital-siv.cedar
    jq '[.cases[] | select(.revision == "RandomizedGcm")][0].policies' .lake/build/pseudonymization-validated-manifest.json | cargo run --locked --quiet --features cedar-runtime --manifest-path rust/Cargo.toml -- render > .lake/build/randomized-gcm.cedar
    cmp .lake/build/randomized-gcm.cedar Examples/Health/Pseudonymization/Policies/randomized-gcm.cedar
    jq '[.cases[] | select(.revision == "OneWayHmac")][0].policies' .lake/build/pseudonymization-validated-manifest.json | cargo run --locked --quiet --features cedar-runtime --manifest-path rust/Cargo.toml -- render > .lake/build/one-way-hmac.cedar
    cmp .lake/build/one-way-hmac.cedar Examples/Health/Pseudonymization/Policies/one-way-hmac.cedar
    jq '[.cases[] | select(.revision == "AgentIncident")][0].policies' .lake/build/pseudonymization-validated-manifest.json | cargo run --locked --quiet --features cedar-runtime --manifest-path rust/Cargo.toml -- render > .lake/build/agent-incident.cedar
    cmp .lake/build/agent-incident.cedar Examples/Health/Pseudonymization/Policies/agent-incident.cedar
    jq '[.cases[] | select(.revision == "ResultRelease")][0].policies' .lake/build/pseudonymization-validated-manifest.json | cargo run --locked --quiet --features cedar-runtime --manifest-path rust/Cargo.toml -- render > .lake/build/result-release.cedar
    cmp .lake/build/result-release.cedar Examples/Health/Pseudonymization/Policies/result-release.cedar

