set working-directory := '../../..'
export CARGO_TARGET_DIR := "rust/target"

delegation:
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 Examples/Enterprise/Agent/Delegation/AgentDelegation.lean

chain:
    lake build CedarPooSpec.AuthorizationDeltaCompound
    mkdir -p .lake/build/lib/lean/Examples/Enterprise/Agent/Delegation
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 -o .lake/build/lib/lean/Examples/Enterprise/Agent/Delegation/AgentDelegation.olean Examples/Enterprise/Agent/Delegation/AgentDelegation.lean
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 Examples/Enterprise/Agent/Chain/AgentChain.lean

payment:
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 Examples/Enterprise/Agent/Payment/AgentPayment.lean

data-flow:
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 Examples/Enterprise/Agent/DataFlow/AgentDataFlow.lean

session:
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 Examples/Enterprise/Agent/Session/BoundedSession.lean

fanout:
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 Examples/Enterprise/Agent/Fanout/SharedBudget.lean

cross-agent-egress-lean:
    lake build CedarPooSpec.Admission.PolicySnapshot
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 Examples/Enterprise/Agent/Fanout/CrossAgentEgress.lean

cross-agent-egress:
    just build-examples
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 --run Examples/Manifests.lean cross-agent-egress-validated > .lake/build/cross-agent-egress-validated-manifest.json
    jq -e '(.cases | length) == 20 and (.schema[""].actions | keys) == ["read", "send"]' .lake/build/cross-agent-egress-validated-manifest.json > /dev/null
    cargo run --locked --quiet --features cedar-runtime --manifest-path rust/Cargo.toml -- replay-validated-receipts < .lake/build/cross-agent-egress-validated-manifest.json > .lake/build/cross-agent-egress-validated-receipts.json
    jq -e 'length == 20 and all(.[]; .replay.error_policy_ids == [] and (.schema_sha256 | test("^[0-9a-f]{64}$"))) and ([.[] | select(.replay.decision == "deny") | .replay.case_name] | sort) == ["governed-off-task-send-step-0","governed-shared-budget-step-1","governed-shared-ledger-blocks-step-1","history-owner-blocks-shared-egress-step-1","incident-freezes-otherwise-valid-egress-step-1","recovered-keeps-lineage-history-step-1"]' .lake/build/cross-agent-egress-validated-receipts.json > /dev/null
    jq '[.cases[] | select(.revision == "CrossAgentGoverned")][0].policies' .lake/build/cross-agent-egress-validated-manifest.json | cargo run --locked --quiet --features cedar-runtime --manifest-path rust/Cargo.toml -- render > .lake/build/cross-agent-egress-governed.cedar
    cmp .lake/build/cross-agent-egress-governed.cedar Examples/Enterprise/Agent/Fanout/CrossAgentEgressPolicies/governed.cedar
    jq '[.cases[] | select(.revision == "CrossAgentIncident")][0].policies' .lake/build/cross-agent-egress-validated-manifest.json | cargo run --locked --quiet --features cedar-runtime --manifest-path rust/Cargo.toml -- render > .lake/build/cross-agent-egress-incident.cedar
    cmp .lake/build/cross-agent-egress-incident.cedar Examples/Enterprise/Agent/Fanout/CrossAgentEgressPolicies/incident.cedar

department-synthesis-lean:
    timeout --signal=TERM --kill-after=3s 120s lake build Examples.Enterprise.Agent.Department.Simulation

department-synthesis:
    just build-examples
    timeout --signal=TERM --kill-after=3s 120s lake env lean -M 2048 -T 10000000 --run Examples/Manifests.lean department-synthesis-validated > .lake/build/department-synthesis-validated-manifest.json
    jq -e '(.cases | length) == 22 and (.schema[""].actions | keys) == ["read", "send"]' .lake/build/department-synthesis-validated-manifest.json > /dev/null
    cargo run --locked --quiet --features cedar-runtime --manifest-path rust/Cargo.toml -- replay-validated-receipts < .lake/build/department-synthesis-validated-manifest.json > .lake/build/department-synthesis-validated-receipts.json
    jq -e 'length == 22 and all(.[]; .replay.error_policy_ids == [] and (.schema_sha256 | test("^[0-9a-f]{64}$"))) and ([.[] | select(.replay.decision == "deny") | .replay.case_name] | sort) == ["finance-owner-closes-sales-leak-step-0","governed-joint-result-denied-step-2","incident-denies-unaffected-sales-step-1","recovered-retains-aggregation-step-2","revoked-after-read-denied-step-0","revoked-read-denied-step-0","revoked-send-denied-step-0","sales-owner-closes-finance-leak-step-0"]' .lake/build/department-synthesis-validated-receipts.json > /dev/null
    jq '[.cases[] | select(.revision == "DepartmentGoverned")][0].policies' .lake/build/department-synthesis-validated-manifest.json | cargo run --locked --quiet --features cedar-runtime --manifest-path rust/Cargo.toml -- render > .lake/build/department-governed.cedar
    cmp .lake/build/department-governed.cedar Examples/Enterprise/Agent/Department/Policies/governed.cedar
    jq '[.cases[] | select(.revision == "DepartmentIncident")][0].policies' .lake/build/department-synthesis-validated-manifest.json | cargo run --locked --quiet --features cedar-runtime --manifest-path rust/Cargo.toml -- render > .lake/build/department-incident.cedar
    cmp .lake/build/department-incident.cedar Examples/Enterprise/Agent/Department/Policies/incident.cedar
