vars: {d2-config: {data: {figure: |json
{
  "purpose": "architecture",
  "language": "en",
  "width": 1280,
  "primary": "purpose",
  "themes": [
    "sketchbook",
    "compact"
  ],
  "icons": [
    "engineering"
  ],
  "basis": {
    "captureRef": "development-source-observation",
    "modelRefs": [],
    "obligationRefs": [],
    "evidenceRefs": []
  },
  "title": "Zero Trust: objects, retained requirements and use",
  "kind": "proof-reading-map",
  "questions": [
    {
      "ref": "purpose",
      "text": "Why is root preservation insufficient, and what does composition prove?",
      "focusRefs": [
        "sysml",
        "core"
      ]
    }
  ],
  "references": {
    "source": "dev/d2/zero-trust-object-proofs.d2",
    "sysml": "dev/sysml/zero-trust-proofs.sysml",
    "core": "CedarPooSpec/ZeroTrust/Model.lean",
    "profileSource": "CedarPooSpec/ZeroTrust/ProfileObject.lean",
    "sessionSource": "CedarPooSpec/ZeroTrust/ProfileObject.lean",
    "counterSource": "Tests/ZeroTrust/ProfileObject.lean",
    "joinedSource": "CedarPooSpec/ZeroTrust/ProfileObject.lean",
    "preservedSource": "CedarPooSpec/ZeroTrust/ProfileObject.lean",
    "prefixSource": "CedarPooSpec/Gateway/ZeroTrust.lean",
    "continuingSource": "CedarPooSpec/Gateway/ZeroTrust.lean"
  },
  "copy": {
    "description": "Definitions, premises, kernel laws and counterexamples are distinct. Each card names its actual Lean declaration.",
    "status": "Authored proof-reading map. Arrows label premises or lemma use; a conditional theorem is not native Host enforcement."
  },
  "presentation": {
    "options": {
      "elk.direction": "DOWN",
      "elk.layered.spacing.nodeNodeBetweenLayers": "48"
    },
    "edgeLabels": true,
    "legend": true
  },
  "sysml": {
    "source": "dev/sysml/zero-trust-proofs.sysml",
    "view": "ZeroTrustProofs::objects",
    "bindings": {
      "profile": {
        "name": "ZeroTrustProofs::profile",
        "icon": "library"
      },
      "session": {
        "name": "ZeroTrustProofs::session",
        "icon": "library"
      },
      "counter": {
        "name": "ZeroTrustProofs::counter",
        "icon": "decision"
      },
      "joined": {
        "name": "ZeroTrustProofs::joined",
        "icon": "library"
      },
      "preserved": {
        "name": "ZeroTrustProofs::preserved",
        "icon": "evidence"
      },
      "prefix": {
        "name": "ZeroTrustProofs::prefix",
        "icon": "obligation"
      },
      "continuing": {
        "name": "ZeroTrustProofs::continuing",
        "icon": "evidence"
      }
    }
  }
}
|
}}}
profile: "Type-indexed Profile [definition]\noriginal requirement is an index\nrefines : selected implies original"
session: "Session / Contract [definition]\nactual source-bound object reads\nshape checks do not select authority"
counter: "Root-only is insufficient [proved]\nroot <= 10; parent <= 5\nraw override accepts value 8\nthe stricter parent can be lost"
joined: "Composed acceptance [premise]\nrequired-parent AND selected\nat the actual effect and view"
preserved: "Composition [kernel law]\ncomposed_preserves_actual_\nparent_and_original\ngiven: composed requirement holds\nthen: both actual reads + both rules\nand the original requirement"
prefix: "Ongoing evidence [premises]\ncurrent continuing acceptance\ninstalled CommittedPrefix\nauthentic required-parent selection"
continuing: "Continuing use [kernel law]\ncontinuing_objects_preserve_\nparent_and_consumption\ngiven: composition accepted\nthen: parent + current + prefix\noriginal operation cannot reconsume"
profile -> session: "Typed projection and actual source reads"
profile -> counter: "Counterexample to parent preservation inference"
session -> joined: "Retain independent parent and selected Sessions"
counter -> joined: "Design motivation; not a proof-term dependency"
joined -> preserved: "Accepted conjunction is a theorem premise"
preserved -> continuing: "Actual lemma used by Gateway proof"
prefix -> continuing: "Additional continuing framework premises"
