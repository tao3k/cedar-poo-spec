vars: {d2-config: {data: {figure: |json
{
  "purpose": "architecture",
  "language": "en",
  "width": 1120,
  "primary": "purpose",
  "themes": [
    "sketchbook",
    "compact"
  ],
  "icons": [
    "engineering"
  ],
  "basis": {
    "captureRef": "development-source-observation",
    "modelRefs": [],
    "obligationRefs": [],
    "evidenceRefs": []
  },
  "title": "Reusable security. Application-owned effects.",
  "kind": "responsibility-map",
  "questions": [
    {
      "ref": "purpose",
      "text": "How do reusable frameworks reach applications without importing them?",
      "focusRefs": [
        "sysml",
        "lean"
      ]
    }
  ],
  "references": {
    "source": "dev/d2/security-frameworks.d2",
    "sysml": "dev/sysml/security-frameworks.sysml",
    "lean": "CedarPooSpec/ZeroTrust/Model.lean"
  },
  "copy": {
    "description": "Framework requirements and Policy assessment stay reusable; applications specialize their actual use.",
    "status": "Logical specification handoffs; this diagram is not an import proof or an authorization decision."
  },
  "presentation": {
    "options": {
      "elk.direction": "DOWN",
      "elk.layered.spacing.nodeNodeBetweenLayers": "42"
    },
    "edgeLabels": false,
    "legend": true
  },
  "sysml": {
    "source": "dev/sysml/security-frameworks.sysml",
    "view": "CedarFrameworks::overview",
    "bindings": {
      "core": {
        "name": "CedarFrameworks::core",
        "icon": "question"
      },
      "authorization": {
        "name": "CedarFrameworks::authorization",
        "icon": "evidence"
      },
      "poo": {
        "name": "CedarFrameworks::poo",
        "icon": "library"
      },
      "gateway": {
        "name": "CedarFrameworks::gateway",
        "icon": "capture"
      },
      "other": {
        "name": "CedarFrameworks::other",
        "icon": "model"
      }
    }
  }
}
|
}}}
core: "Zero Trust functional core\nPre / ongoing authorization\nConditions and witnessed obligations\nMutable observations and refinement"
authorization: "Authorization framework\nCedar Policy composition\nSchema-bound Delta analysis\nRevision and evidence contracts"
poo: "Generic POO interpretation\nOriginal root as type index\nRequired parent + selected Sessions\nConjoin retained requirements"
gateway: "Gateway specialization\nIdentity / facts / original profile\nPE / PA / PEP application roles\nCurrent use and retained consumption"
other: "Other application specializations\nArtifact access / workflow effects\nIdentity / protected channels / facts\nRecovery and final mediation"
core -> poo: Functional requirements
poo -> other: Typed specialization
poo -> gateway: Actual inherited profile
authorization -> gateway: Bound Policy assessment
