  "title": "Native catalog: transport forms",
  "kind": "catalog-overview",
  "questions": [
    {
      "ref": "purpose",
      "text": "Which transport forms does the native Lean catalog publish?",
      "focusRefs": [
        "sysml",
        "producer"
      ]
    }
  ],
  "references": {
    "source": "dev/d2/lean-catalog.d2",
    "sysml": "dev/sysml/lean-catalog.sysml",
    "producer": "CedarPooSpec/Transport/SourceCatalog.lean"
  },
  "copy": {
    "description": "These categories describe JSON transport forms, not vertical industries or model Components. Counts are checked through the SDK.",
