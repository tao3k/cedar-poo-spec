vars: {d2-config: {data: {figure: |json
{
  "purpose": "architecture",
  "language": "en",
  "width": 1280,
  "primary": "purpose",
  "themes": [
    "sketchbook",
    "compact"
  ],
  "icons": [
    "engineering"
  ],
  "basis": {
    "captureRef": "development-source-observation",
    "modelRefs": [],
    "obligationRefs": [],
    "evidenceRefs": []
  },
  "title": "Cedar model: Components, domains and consumers",
  "kind": "responsibility-map",
  "questions": [
    {
      "ref": "purpose",
      "text": "How are reusable Components composed into distinct consumers?",
      "focusRefs": [
        "sysml",
        "library"
      ]
    }
  ],
  "references": {
    "source": "dev/d2/architecture-overview.d2",
    "sysml": "dev/sysml/architecture.sysml",
    "library": "CedarPooSpec.lean",
    "modelSource": "CedarPooSpec.lean",
    "zeroTrustSource": "CedarPooSpec/ZeroTrust/README.org",
    "verticalControlsSource": "CedarPooSpec/Vertical/Health/README.org",
    "platformProjectionsSource": "CedarPooSpec/Platform/AWS/AgentCore/README.org",
    "productionSource": "Productions/README.org",
    "examplesSource": "Examples/README.org",
    "rustSource": "rust/README.org",
    "hostSource": "Productions/Backend.org"
  },
  "copy": {
    "description": "Zero Trust is an explicit model Component. Industry controls and platform projections remain distinct.",
    "status": "Arrows describe selected composition and ownership handoffs, not mandatory imports or deployed effects."
  },
  "presentation": {
    "options": {
      "elk.direction": "DOWN",
      "elk.layered.spacing.nodeNodeBetweenLayers": "42"
    },
    "edgeLabels": false,
    "legend": true
  },
  "sysml": {
    "source": "dev/sysml/architecture.sysml",
    "view": "CedarArchitecture::overview",
    "bindings": {
      "leanPoo": {
        "name": "CedarArchitecture::leanPoo",
        "icon": "library"
      },
      "cedar": {
        "name": "CedarArchitecture::cedar",
        "icon": "library"
      },
      "model": {
        "name": "CedarArchitecture::model",
        "icon": "library"
      },
      "zeroTrust": {
        "name": "CedarArchitecture::zeroTrust",
        "icon": "obligation"
      },
      "verticalControls": {
        "name": "CedarArchitecture::verticalControls",
        "icon": "model"
      },
      "platformProjections": {
        "name": "CedarArchitecture::platformProjections",
        "icon": "model"
      },
      "production": {
        "name": "CedarArchitecture::production",
        "icon": "model"
      },
      "examples": {
