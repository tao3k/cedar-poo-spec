# Fixed 128-read, three-sample local probe; timings have no pass/fail threshold.
bench-functional-reuse: build
    lake build functionalReuseNative
    timeout --signal=TERM --kill-after=3s 120s .lake/build/bin/functionalReuseNative CrossAgentGoverned

# Native Rust, fixed full catalog. Time observations never change admission.
bench-functional-catalog: check-functional-catalog
    cargo build --release --locked -p cedar-poo-bridge --manifest-path Cargo.toml
    timeout --signal=TERM --kill-after=3s 120s uv run --project python --package cedar-poo-py-test --locked python -m cedar_poo_py_test.resources --output .lake/build/resources/rust-latency.json rust/target/release/cedar-poo-bridge benchmark-catalog < .lake/build/functional-catalog.json > .lake/build/functional-native-benchmark.json
    jq -e -f Tests/Conformance/native-catalog-benchmark.jq .lake/build/functional-native-benchmark.json > /dev/null
    jq -c '{build_profile,warmup,cli,lifecycle,samples}' .lake/build/functional-native-benchmark.json
    # A freshly materialized executable plus two repeated invocations; same fixed native workload.
    mkdir -p .lake/build/native-process
    cohort=$(mktemp -d .lake/build/native-process/cohort.XXXXXX); cp rust/target/release/cedar-poo-bridge "$cohort/bridge"; for stage in fresh repeated-1 repeated-2; do timeout --signal=TERM --kill-after=3s 120s uv run --project python --package cedar-poo-py-test --locked python -m cedar_poo_py_test.resources --output ".lake/build/resources/rust-launch-$stage.json" "$cohort/bridge" benchmark-catalog < .lake/build/functional-catalog.json > ".lake/build/functional-launch-$stage.json" || exit $?; jq -e -f Tests/Conformance/native-catalog-benchmark.jq ".lake/build/functional-launch-$stage.json" > /dev/null || exit $?; jq -c --arg stage "$stage" '{observation:"native-launch-cohort",stage:$stage,build_profile,warmup,cli,lifecycle,samples}' ".lake/build/functional-launch-$stage.json"; done


# Native workloads; Python observes only their outer process/OS resources.
bench-functional-native: build
    lake build functionalReuseNative objectProfilesNative
    timeout --signal=TERM --kill-after=3s 120s uv run --project python --package cedar-poo-py-test --locked python -m cedar_poo_py_test.resources --output .lake/build/resources/lean-profiles.json .lake/build/bin/objectProfilesNative
    timeout --signal=TERM --kill-after=3s 120s uv run --project python --package cedar-poo-py-test --locked python -m cedar_poo_py_test.resources --output .lake/build/resources/lean-checks-only.json .lake/build/bin/objectProfilesNative --checks-only

    timeout --signal=TERM --kill-after=3s 120s uv run --project python --package cedar-poo-py-test --locked python -m cedar_poo_py_test.resources --output .lake/build/resources/lean-reuse.json .lake/build/bin/functionalReuseNative CrossAgentGoverned
    timeout --signal=TERM --kill-after=3s 120s uv run --project python --package cedar-poo-py-test --locked python -m cedar_poo_py_test.resources --output .lake/build/resources/lean-root-scale.json .lake/build/bin/functionalReuseNative --root-scale
    for family in policy banking location source protection controller disclosure handoff lineage; do timeout --signal=TERM --kill-after=3s 120s uv run --project python --package cedar-poo-py-test --locked python -m cedar_poo_py_test.resources --output ".lake/build/resources/lean-$family.json" .lake/build/bin/objectProfilesNative --probe "$family" > ".lake/build/resources/lean-$family.log" || exit $?; done

# Separate instrumented process: allocation counters do not qualify ordinary latency.
bench-functional-allocation: bench-functional-catalog
    cargo build --release --locked -p cedar-poo-bridge --features allocation-observation --manifest-path Cargo.toml
    timeout --signal=TERM --kill-after=3s 120s uv run --project python --package cedar-poo-py-test --locked python -m cedar_poo_py_test.resources --output .lake/build/resources/rust-allocation.json rust/target/release/cedar-poo-bridge benchmark-catalog < .lake/build/functional-catalog.json > .lake/build/functional-allocation-benchmark.json
    jq -e -f Tests/Conformance/native-catalog-benchmark.jq .lake/build/functional-allocation-benchmark.json > /dev/null
    jq -e 'all(.samples[]; .allocation.allocation_requests > 0)' .lake/build/functional-allocation-benchmark.json > /dev/null
    jq -c '{build_profile,warmup,cli,lifecycle,samples}' .lake/build/functional-allocation-benchmark.json

